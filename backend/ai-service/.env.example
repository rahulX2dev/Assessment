APP_ENV=development
PORT=8000

JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ISSUER=hubflow-core
INTERNAL_SERVICE_TOKEN=shared-secret-between-internal-services

POSTGRES_DSN=postgresql+psycopg://hubflow:hubflow@localhost:5432/hubflow_analytics
REDIS_URL=redis://localhost:6379/1

CORE_SERVICE_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

SCHEDULER_ENABLED=true
LOG_LEVEL=INFO
