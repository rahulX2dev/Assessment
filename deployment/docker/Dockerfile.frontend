FROM node:22-alpine AS build
WORKDIR /app

ARG VITE_GATEWAY_URL=/api
ARG VITE_STORE_API_URL=https://fakestoreapi.com
ARG VITE_API_TIMEOUT=12000
ARG VITE_GATEWAY_TIMEOUT=6000

ENV VITE_GATEWAY_URL=$VITE_GATEWAY_URL \
    VITE_STORE_API_URL=$VITE_STORE_API_URL \
    VITE_API_TIMEOUT=$VITE_API_TIMEOUT \
    VITE_GATEWAY_TIMEOUT=$VITE_GATEWAY_TIMEOUT

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
RUN rm /etc/nginx/conf.d/default.conf

COPY deployment/nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
