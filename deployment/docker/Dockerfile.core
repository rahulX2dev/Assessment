FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build

COPY backend/core-service/pom.xml ./
RUN mvn -B dependency:go-offline

COPY backend/core-service/src ./src
RUN mvn -B clean package -DskipTests

FROM eclipse-temurin:17-jre-alpine AS runtime
RUN addgroup -S hubflow && adduser -S hubflow -G hubflow

WORKDIR /app
COPY --from=build /build/target/core-service-1.0.0.jar app.jar
RUN chown -R hubflow:hubflow /app

USER hubflow
EXPOSE 8081

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError" \
    SPRING_PROFILES_ACTIVE=prod

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8081/actuator/health/liveness || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
