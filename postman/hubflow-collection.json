{
  "info": {
    "name": "Hubflow Automation API",
    "description": "End-to-end collection for the Hubflow platform. Requests are ordered so that running the folder top to bottom registers a tenant, verifies OTP, builds a CRM record, dispatches a campaign, subscribes to a plan and exercises the AI service. Tokens and ids are captured into collection variables automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gatewayUrl", "value": "http://localhost:8080/api" },
    { "key": "coreUrl", "value": "http://localhost:8081" },
    { "key": "aiUrl", "value": "http://localhost:8000" },
    { "key": "internalToken", "value": "shared-secret-between-internal-services" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "tenantId", "value": "" },
    { "key": "contactId", "value": "" },
    { "key": "dealId", "value": "" },
    { "key": "templateId", "value": "" },
    { "key": "campaignId", "value": "" },
    { "key": "employeeId", "value": "" },
    { "key": "leaveId", "value": "" },
    { "key": "otpCode", "value": "" },
    { "key": "testEmail", "value": "" },
    { "key": "testPhone", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('testEmail')) {",
          "    const suffix = Math.floor(Math.random() * 90000) + 10000;",
          "    pm.collectionVariables.set('testEmail', `owner${suffix}@acme-retail.in`);",
          "    pm.collectionVariables.set('testPhone', `+91981234${suffix}`);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Gateway health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/health", "host": ["{{gatewayUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('gateway is up', () => pm.response.to.have.status(200));",
                  "pm.test('reports service name', () => {",
                  "    pm.expect(pm.response.json().data.service).to.eql('api-gateway');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway readiness",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/health/ready", "host": ["{{gatewayUrl}}"], "path": ["health", "ready"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns upstream and circuit state', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data).to.have.property('upstreams');",
                  "    pm.expect(body.data).to.have.property('circuits');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "AI service health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{aiUrl}}/health", "host": ["{{aiUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register tenant and owner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rahul Pathak\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"{{testPhone}}\",\n  \"password\": \"StrongPassw0rd!\",\n  \"companyName\": \"Acme Retail Pvt Ltd\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/auth/register", "host": ["{{gatewayUrl}}"], "path": ["v1", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('tenantId', data.user.tenantId);",
                  "pm.test('owner and admin roles granted', () => {",
                  "    pm.expect(data.user.roles).to.include.members(['OWNER', 'ADMIN']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register duplicate email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate\",\n  \"email\": \"{{testEmail}}\",\n  \"phone\": \"+919876500000\",\n  \"password\": \"StrongPassw0rd!\",\n  \"companyName\": \"Duplicate Co\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/auth/register", "host": ["{{gatewayUrl}}"], "path": ["v1", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected as conflict', () => pm.response.to.have.status(409));",
                  "pm.test('error code is CONFLICT', () => {",
                  "    pm.expect(pm.response.json().error.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Register with invalid payload (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"X\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"123\",\n  \"password\": \"short\",\n  \"companyName\": \"Y\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/auth/register", "host": ["{{gatewayUrl}}"], "path": ["v1", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('validation rejected', () => pm.response.to.have.status(400));",
                  "pm.test('names the offending fields', () => {",
                  "    const details = pm.response.json().error.details;",
                  "    pm.expect(Object.keys(details)).to.include.members(['email', 'password']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"StrongPassw0rd!\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/auth/login", "host": ["{{gatewayUrl}}"], "path": ["v1", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"purpose\": \"PHONE_VERIFICATION\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/auth/otp/send", "host": ["{{gatewayUrl}}"], "path": ["v1", "auth", "otp", "send"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('otp issued', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('phone is masked in the response', () => {",
                  "    pm.expect(data.phone).to.include('*');",
                  "});",
                  "if (data.devCode) {",
                  "    pm.collectionVariables.set('otpCode', data.devCode);",
                  "} else {",
                  "    console.log('devCode hidden: set hubflow.otp.expose-code=true in the dev profile');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{testPhone}}\",\n  \"code\": \"{{otpCode}}\",\n  \"purpose\": \"PHONE_VERIFICATION\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/auth/otp/verify", "host": ["{{gatewayUrl}}"], "path": ["v1", "auth", "otp", "verify"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('phone verified', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Current profile",
          "request": {
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/v1/auth/me", "host": ["{{gatewayUrl}}"], "path": ["v1", "auth", "me"] }
          }
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/v1/auth/refresh", "host": ["{{gatewayUrl}}"], "path": ["v1", "auth", "refresh"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rotated', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthenticated request (expect 401)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/v1/crm/contacts", "host": ["{{gatewayUrl}}"], "path": ["v1", "crm", "contacts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected without a token', () => pm.response.to.have.status(401));",
                  "pm.test('error code is UNAUTHORIZED', () => {",
                  "    pm.expect(pm.response.json().error.code).to.eql('UNAUTHORIZED');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CRM",
      "item": [
        {
          "name": "Create contact",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Meera Joshi\",\n  \"phone\": \"+919812345678\",\n  \"email\": \"meera@nexora.in\",\n  \"companyName\": \"Nexora Retail\",\n  \"source\": \"landing_page\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/crm/contacts", "host": ["{{gatewayUrl}}"], "path": ["v1", "crm", "contacts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('contactId', data.id);",
                  "pm.test('starts in the NEW stage', () => pm.expect(data.lifecycleStage).to.eql('NEW'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search contacts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/v1/crm/contacts?page=0&size=20&search=meera",
              "host": ["{{gatewayUrl}}"],
              "path": ["v1", "crm", "contacts"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "search", "value": "meera" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns pagination meta', () => {",
                  "    pm.expect(pm.response.json().meta).to.have.property('totalElements');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate phone (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Duplicate Contact\",\n  \"phone\": \"+919812345678\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/crm/contacts", "host": ["{{gatewayUrl}}"], "path": ["v1", "crm", "contacts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('conflict on duplicate phone', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "Create deal",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactId\": \"{{contactId}}\",\n  \"title\": \"Annual Growth plan\",\n  \"value\": 95988,\n  \"stage\": \"QUALIFIED\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/crm/deals", "host": ["{{gatewayUrl}}"], "path": ["v1", "crm", "deals"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('dealId', data.id);",
                  "pm.test('probability derived from stage', () => pm.expect(data.winProbability).to.eql(30));"
                ]
              }
            }
          ]
        },
        {
          "name": "Move deal to NEGOTIATION",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stage\": \"NEGOTIATION\"\n}" },
            "url": {
              "raw": "{{gatewayUrl}}/v1/crm/deals/{{dealId}}/stage",
              "host": ["{{gatewayUrl}}"],
              "path": ["v1", "crm", "deals", "{{dealId}}", "stage"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('probability updated to 75', () => {",
                  "    pm.expect(pm.response.json().data.winProbability).to.eql(75);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark LOST without reason (expect 400)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"stage\": \"LOST\"\n}" },
            "url": {
              "raw": "{{gatewayUrl}}/v1/crm/deals/{{dealId}}/stage",
              "host": ["{{gatewayUrl}}"],
              "path": ["v1", "crm", "deals", "{{dealId}}", "stage"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('lostReason is enforced', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Campaigns",
      "item": [
        {
          "name": "Create template",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"monsoon_offer\",\n  \"language\": \"en\",\n  \"category\": \"MARKETING\",\n  \"bodyText\": \"Hi, our monsoon sale is live with up to 45% off.\"\n}"
            },
            "url": {
              "raw": "{{coreUrl}}/api/v1/campaigns/templates",
              "host": ["{{coreUrl}}"],
              "path": ["api", "v1", "campaigns", "templates"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('templateId', data.id);",
                  "pm.test('starts PENDING approval', () => pm.expect(data.approvalStatus).to.eql('PENDING'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Campaign on unapproved template (expect 400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monsoon push\",\n  \"templateId\": \"{{templateId}}\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/campaigns", "host": ["{{gatewayUrl}}"], "path": ["v1", "campaigns"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('blocked until approved', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "Approve template",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{coreUrl}}/api/v1/campaigns/templates/{{templateId}}/approval?status=APPROVED",
              "host": ["{{coreUrl}}"],
              "path": ["api", "v1", "campaigns", "templates", "{{templateId}}", "approval"],
              "query": [{ "key": "status", "value": "APPROVED" }]
            }
          }
        },
        {
          "name": "Create campaign",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Monsoon push\",\n  \"templateId\": \"{{templateId}}\"\n}"
            },
            "url": { "raw": "{{gatewayUrl}}/v1/campaigns", "host": ["{{gatewayUrl}}"], "path": ["v1", "campaigns"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('campaignId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Dispatch campaign",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{gatewayUrl}}/v1/campaigns/{{campaignId}}/dispatch",
              "host": ["{{gatewayUrl}}"],
              "path": ["v1", "campaigns", "{{campaignId}}", "dispatch"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('accepted for dispatch', () => pm.response.to.have.status(202));",
                  "const data = pm.response.json().data;",
                  "pm.test('reports queued recipients and a batch id', () => {",
                  "    pm.expect(data.queuedRecipients).to.be.above(0);",
                  "    pm.expect(data.queueBatchId).to.include('batch_');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Dispatch again (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{gatewayUrl}}/v1/campaigns/{{campaignId}}/dispatch",
              "host": ["{{gatewayUrl}}"],
              "path": ["v1", "campaigns", "{{campaignId}}", "dispatch"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('double dispatch blocked', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "Campaign stats",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gatewayUrl}}/v1/campaigns/{{campaignId}}/stats",
              "host": ["{{gatewayUrl}}"],
              "path": ["v1", "campaigns", "{{campaignId}}", "stats"]
            }
          }
        },
        {
          "name": "WhatsApp delivery webhook",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entry\": [\n    {\n      \"changes\": [\n        {\n          \"value\": {\n            \"statuses\": [\n              { \"id\": \"wamid.demo.1\", \"status\": \"delivered\" },\n              { \"id\": \"wamid.demo.2\", \"status\": \"read\" }\n            ]\n          }\n        }\n      ]\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{coreUrl}}/api/v1/webhooks/whatsapp",
              "host": ["{{coreUrl}}"],
              "path": ["api", "v1", "webhooks", "whatsapp"]
            }
          }
        }
      ]
    },
    {
      "name": "Billing",
      "item": [
        {
          "name": "Plan catalogue (public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{gatewayUrl}}/v1/billing/plans", "host": ["{{gatewayUrl}}"], "path": ["v1", "billing", "plans"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('three plans returned', () => {",
                  "    pm.expect(pm.response.json().data).to.have.lengthOf(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Subscribe to Growth yearly",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"planId\": \"growth\",\n  \"billingCycle\": \"YEARLY\"\n}" },
            "url": { "raw": "{{gatewayUrl}}/v1/billing/subscription", "host": ["{{gatewayUrl}}"], "path": ["v1", "billing", "subscription"] }
          },
